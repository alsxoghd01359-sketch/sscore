<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101411"
    android:orientation="vertical">

    <!-- 시즌 드롭다운 -->
    <Spinner android:id="@+id/spinnerSeason"
        android:layout_width="wrap_content" android:layout_height="40dp"
        android:layout_marginStart="12dp" android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="#1C1C1C"
        android:paddingHorizontal="10dp"/>

    <!-- 헤더 행 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="10dp" android:background="#1A1A1A">
        <TextView android:layout_width="28dp" android:layout_height="wrap_content"
            android:text="#" android:textColor="#888888" android:textSize="12sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="팀" android:textColor="#888888" android:textSize="12sp"
            android:layout_marginStart="36dp"/>
        <TextView android:layout_width="28dp" android:layout_height="wrap_content"
            android:text="경기" android:textColor="#888888" android:textSize="11sp" android:gravity="center"/>
        <TextView android:layout_width="24dp" android:layout_height="wrap_content"
            android:text="승" android:textColor="#888888" android:textSize="11sp" android:gravity="center"/>
        <TextView android:layout_width="24dp" android:layout_height="wrap_content"
            android:text="무" android:textColor="#888888" android:textSize="11sp" android:gravity="center"/>
        <TextView android:layout_width="24dp" android:layout_height="wrap_content"
            android:text="패" android:textColor="#888888" android:textSize="11sp" android:gravity="center"/>
        <TextView android:layout_width="36dp" android:layout_height="wrap_content"
            android:text="득실" android:textColor="#888888" android:textSize="11sp" android:gravity="center"/>
        <TextView android:layout_width="32dp" android:layout_height="wrap_content"
            android:text="승점" android:textColor="#FFFFFF" android:textSize="11sp"
            android:textStyle="bold" android:gravity="center"/>
    </LinearLayout>

    <ProgressBar android:id="@+id/pbLoading"
        android:layout_width="wrap_content" android:layout_height="48dp"
        android:layout_gravity="center" android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStandings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>