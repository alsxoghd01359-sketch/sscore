<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101411">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bottomNav"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="40dp"
                    android:src="@drawable/livescore1"
                    android:scaleType="fitStart" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnCalendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="26/5/6 ▼"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:background="#181C19" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDateList"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="12dp" />

            <!-- 5대 리그 탭 추가됨 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tabAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="전체"
                        android:textColor="#20E07A"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tabEpl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EPL"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tabLaLiga"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="라리가"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tabSerieA"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="세리에 A"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tabBundesliga"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="분데스리가"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tabLigue1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="리그 1"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:padding="8dp"/>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today Matches"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMatches"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_alignParentBottom="true"
            android:background="#181C19"
            android:orientation="horizontal">
            <TextView android:id="@+id/navMatch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="경기" android:textColor="#20E07A" android:textStyle="bold" />
            <TextView android:id="@+id/navSearch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="검색" android:textColor="#FFFFFF" />
        </LinearLayout>
    </RelativeLayout>
</layout>