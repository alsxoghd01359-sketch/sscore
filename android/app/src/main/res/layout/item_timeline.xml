<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 중앙 타임라인 선 -->
    <View
        android:id="@+id/vCenterLine"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="#444444"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 중앙 시간 텍스트 -->
    <TextView
        android:id="@+id/tvEventTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00'"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        android:background="#1E1E1E"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 홈팀 이벤트 (왼쪽) -->
    <LinearLayout
        android:id="@+id/layoutHomeEvent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvEventTime">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvHomePlayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvHomeAssist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#888888"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 아이콘 영역: 이모지 TextView + 패널티 실축 ImageView 겹침 -->
        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp">

            <TextView
                android:id="@+id/tvHomeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/ivHomePenMiss"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_penalty_miss"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

    <!-- 원정팀 이벤트 (오른쪽) -->
    <LinearLayout
        android:id="@+id/layoutAwayEvent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvEventTime"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 아이콘 영역: 이모지 TextView + 패널티 실축 ImageView 겹침 -->
        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp">

            <TextView
                android:id="@+id/tvAwayIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/ivAwayPenMiss"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_penalty_miss"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvAwayPlayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAwayAssist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#888888"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>