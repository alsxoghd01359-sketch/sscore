<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <ProgressBar
        android:id="@+id/pbSquadLoading"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 골키퍼 박스 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="골키퍼" android:textColor="@color/text_secondary"
                android:textSize="13sp" android:textStyle="bold"
                android:layout_marginBottom="6dp"/>
            <LinearLayout android:id="@+id/layoutGK"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/surface" android:orientation="vertical"
                android:layout_marginBottom="16dp"/>

            <!-- 수비수 박스 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="수비수" android:textColor="@color/text_secondary"
                android:textSize="13sp" android:textStyle="bold"
                android:layout_marginBottom="6dp"/>
            <LinearLayout android:id="@+id/layoutDF"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/surface" android:orientation="vertical"
                android:layout_marginBottom="16dp"/>

            <!-- 미드필더 박스 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="미드필더" android:textColor="@color/text_secondary"
                android:textSize="13sp" android:textStyle="bold"
                android:layout_marginBottom="6dp"/>
            <LinearLayout android:id="@+id/layoutMF"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/surface" android:orientation="vertical"
                android:layout_marginBottom="16dp"/>

            <!-- 공격수 박스 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="공격수" android:textColor="@color/text_secondary"
                android:textSize="13sp" android:textStyle="bold"
                android:layout_marginBottom="6dp"/>
            <LinearLayout android:id="@+id/layoutFW"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/surface" android:orientation="vertical"
                android:layout_marginBottom="8dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>