<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 시즌 선택 바 (순위탭과 동일 디자인) -->
    <LinearLayout
        android:id="@+id/layoutSeasonSelector"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="@drawable/season_selector_bg"
        android:layout_margin="3dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView android:id="@+id/ivLeagueLogo"
            android:layout_width="26dp" android:layout_height="26dp"/>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:id="@+id/tvLeagueName"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvCurrentSeason"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_muted" android:textSize="11sp"/>
        </LinearLayout>

        <TextView android:id="@+id/tvDropdownArrow"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="▼" android:textColor="@color/text_muted" android:textSize="12sp"/>
    </LinearLayout>

    <!-- 시즌 드롭다운 목록 -->
    <ScrollView android:id="@+id/scrollSeasonList"
        android:layout_width="match_parent" android:layout_height="220dp"
        android:background="@color/surface" android:visibility="gone">
        <LinearLayout android:id="@+id/layoutSeasonList"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <!-- 콘텐츠 스크롤 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 로딩 인디케이터 -->
            <ProgressBar android:id="@+id/pbLoading"
                android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_gravity="center" android:visibility="gone"/>

    <include android:id="@+id/errorView" layout="@layout/view_error"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone"/>

            <!-- ① 홈/원정 성적 카드 -->
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="홈 / 원정 성적"
                android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <LinearLayout android:id="@+id/layoutRecord"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/card_bg" android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <!-- 헤더 행 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="30dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="12dp" android:background="@color/surface">
                    <View android:layout_width="28dp" android:layout_height="1dp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.5" android:gravity="center"
                        android:text="경기" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.4" android:gravity="center"
                        android:text="승" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.4" android:gravity="center"
                        android:text="무" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.4" android:gravity="center"
                        android:text="패" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1.0" android:gravity="center"
                        android:text="+/-" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.6" android:gravity="center"
                        android:text="=" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.55" android:gravity="center"
                        android:text="승점" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                </LinearLayout>

                <!-- 홈 행 -->
                <LinearLayout android:id="@+id/rowHome"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">
                    <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                        android:text="홈" android:textColor="@color/accent" android:textSize="14sp"
                        android:textStyle="bold" android:gravity="center"/>
                    <TextView android:id="@+id/tvHomePlayed" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.5" android:gravity="center" android:textColor="@color/text_primary" android:textSize="15sp"/>
                    <TextView android:id="@+id/tvHomeWin" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.4" android:gravity="center" android:textColor="@color/text_primary" android:textSize="15sp"/>
                    <TextView android:id="@+id/tvHomeDraw" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.4" android:gravity="center" android:textColor="@color/text_primary" android:textSize="15sp"/>
                    <TextView android:id="@+id/tvHomeLose" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.4" android:gravity="center" android:textColor="@color/text_primary" android:textSize="15sp"/>
                    <TextView android:id="@+id/tvHomeGoals" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1.0" android:gravity="center" android:textColor="@color/text_body" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvHomeGoalDiff" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.6" android:gravity="center" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvHomePoints" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.55" android:gravity="center" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
                </LinearLayout>

                <!-- 구분선 -->
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/surface_variant" android:layout_marginHorizontal="12dp"/>

                <!-- 원정 행 -->
                <LinearLayout android:id="@+id/rowAway"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">
                    <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                        android:text="원정" android:textColor="@color/info" android:textSize="14sp"
                        android:textStyle="bold" android:gravity="center"/>
                    <TextView android:id="@+id/tvAwayPlayed" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.5" android:gravity="center" android:textColor="@color/text_primary" android:textSize="15sp"/>
                    <TextView android:id="@+id/tvAwayWin" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.4" android:gravity="center" android:textColor="@color/text_primary" android:textSize="15sp"/>
                    <TextView android:id="@+id/tvAwayDraw" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.4" android:gravity="center" android:textColor="@color/text_primary" android:textSize="15sp"/>
                    <TextView android:id="@+id/tvAwayLose" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.4" android:gravity="center" android:textColor="@color/text_primary" android:textSize="15sp"/>
                    <TextView android:id="@+id/tvAwayGoals" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1.0" android:gravity="center" android:textColor="@color/text_body" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvAwayGoalDiff" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.6" android:gravity="center" android:textSize="14sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvAwayPoints" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="0.55" android:gravity="center" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ② 평균 평점 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="평균 평점" android:textColor="@color/text_primary"
                    android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvRatingToggle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="전체보기 ▼" android:textColor="@color/text_secondary" android:textSize="13sp"
                    android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/layoutRatingList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/card_bg" android:orientation="vertical"
                android:layout_marginBottom="20dp"/>

            <!-- ③ 득점 순위 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="득점 순위" android:textColor="@color/text_primary"
                    android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvGoalToggle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="전체보기 ▼" android:textColor="@color/text_secondary" android:textSize="13sp"
                    android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/layoutGoalList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/card_bg" android:orientation="vertical"
                android:layout_marginBottom="20dp"/>

            <!-- ④ 도움 순위 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="도움 순위" android:textColor="@color/text_primary"
                    android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvAssistToggle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="전체보기 ▼" android:textColor="@color/text_secondary" android:textSize="13sp"
                    android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/layoutAssistList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/card_bg" android:orientation="vertical"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>