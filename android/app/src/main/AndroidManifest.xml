<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".auth.SScoreApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/livescore_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/livescore_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.SScore"
        tools:targetApi="31">

        <!-- 알림을 누르면 열리는 화면 (서버가 보낸 푸시의 click_action = OPEN_MATCH) -->
        <activity
            android:name=".push.PushLaunchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="OPEN_MATCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".push.PushMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".auth.PasswordResetActivity"
            android:exported="false" />

        <activity
            android:name=".member.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".match.MatchDetailActivity"
            android:exported="false" />

        <activity
            android:name=".team.TeamDetailActivity"
            android:exported="false" />
        <activity
            android:name=".player.PlayerDetailActivity"
            android:exported="false" />
        <activity
            android:name=".league.LeagueDetailActivity"
            android:exported="false" />
        <activity
            android:name=".notification.NotificationSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".follow.FollowListActivity"
            android:exported="false" />

        <activity
            android:name=".search.SearchActivity"
            android:exported="false" />
    </application>

</manifest>