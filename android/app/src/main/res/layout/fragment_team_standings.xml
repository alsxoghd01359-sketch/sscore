<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101411"
    android:orientation="vertical"
    android:padding="3dp">

    <!-- 시즌 선택 바: 회색 둥근 카드 + 좌우/위 3dp 여백 -->
    <LinearLayout
        android:id="@+id/layoutSeasonSelector"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="@drawable/season_selector_bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivLeagueLogo"
            android:layout_width="26dp"
            android:layout_height="26dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/tvLeagueName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrentSeason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDropdownArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▼"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 시즌 드롭다운 목록 - 고정 높이로 스크롤 가능 -->
    <ScrollView
        android:id="@+id/scrollSeasonList"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#1E1E1E"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layoutSeasonList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- 구분 여백 (3dp) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp" />

    <!-- 순위표 헤더 (item_standing.xml 컬럼과 동일한 weight) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="#1C1C1C">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:text="#" android:textColor="#888888" android:textSize="11sp"
            android:gravity="center"/>
        <!-- 로고 자리 스페이서 (20dp + 6dp margin) -->
        <View android:layout_width="26dp" android:layout_height="1dp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="2.0"
            android:text="팀" android:textColor="#888888" android:textSize="11sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="0.45"
            android:text="경기" android:textColor="#888888" android:textSize="10sp"
            android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:text="승" android:textColor="#888888" android:textSize="10sp"
            android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:text="무" android:textColor="#888888" android:textSize="10sp"
            android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:text="패" android:textColor="#888888" android:textSize="10sp"
            android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="+/-" android:textColor="#888888" android:textSize="10sp"
            android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="0.65"
            android:text="=" android:textColor="#888888" android:textSize="10sp"
            android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="0.55"
            android:text="승점" android:textColor="#888888" android:textSize="10sp"
            android:gravity="center"/>
    </LinearLayout>

    <!-- 로딩 인디케이터 -->
    <ProgressBar
        android:id="@+id/pbStandingsLoading"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <!-- 순위표 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTeamStandings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>