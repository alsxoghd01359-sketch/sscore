<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="32dp"
            android:text="S-SCORE 가입하기"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <!-- 1단계: 가입 정보 입력 -->
        <LinearLayout
            android:id="@+id/groupForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etRegEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/edittext_bg"
                android:hint="이메일"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"/>

            <EditText
                android:id="@+id/etRegNickname"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/edittext_bg"
                android:hint="닉네임"
                android:inputType="text"
                android:maxLength="12"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"/>

            <TextView
                android:id="@+id/tvNicknameHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="2~12자, 한글·영문·숫자만 사용할 수 있어요."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/etRegPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/edittext_bg"
                android:hint="비밀번호"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="8~20자, 특수문자를 1개 이상 포함해야 해요."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:backgroundTint="@color/accent"
                android:text="인증코드 받기"
                android:textColor="@color/on_accent"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- 2단계: 이메일로 받은 인증코드 입력 -->
        <LinearLayout
            android:id="@+id/groupCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCodeInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="@color/text_body"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/etCode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/edittext_bg"
                android:gravity="center"
                android:hint="인증코드 6자리"
                android:inputType="number"
                android:letterSpacing="0.3"
                android:maxLength="6"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="22sp"/>

            <Button
                android:id="@+id/btnVerify"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:backgroundTint="@color/accent"
                android:text="가입 완료"
                android:textColor="@color/on_accent"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnResend"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/accent"/>

            <TextView
                android:id="@+id/tvChangeEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:padding="8dp"
                android:text="이메일/닉네임 다시 입력"
                android:textColor="@color/text_secondary"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/negative"
            android:textSize="13sp"
            android:visibility="gone"/>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/accent"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:text="이미 계정이 있나요? 로그인"
            android:textColor="@color/text_secondary"/>
    </LinearLayout>
</ScrollView>
