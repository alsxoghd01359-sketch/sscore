<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1C1F1D" />
        </shape>
    </item>

    <item
        android:height="3dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="#80FFFFFF" />
        </shape>
    </item>

    <item
        android:width="80dp"
        android:height="80dp"
        android:gravity="center">
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="#80FFFFFF" />
        </shape>
    </item>

    <item
        android:top="-3dp"
        android:width="60dp"
        android:height="25dp"
        android:gravity="top|center_horizontal">
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="#80FFFFFF" />
        </shape>
    </item>

    <item
        android:top="-3dp"
        android:width="120dp"
        android:height="55dp"
        android:gravity="top|center_horizontal">
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="#80FFFFFF" />
        </shape>
    </item>

    <item
        android:bottom="-3dp"
        android:width="60dp"
        android:height="25dp"
        android:gravity="bottom|center_horizontal">
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="#80FFFFFF" />
        </shape>
    </item>

    <item
        android:bottom="-3dp"
        android:width="120dp"
        android:height="55dp"
        android:gravity="bottom|center_horizontal">
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="#80FFFFFF" />
        </shape>
    </item>

</layer-list>