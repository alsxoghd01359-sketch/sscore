<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101411"
    android:orientation="vertical">

    <Spinner android:id="@+id/spinnerSeason"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginHorizontal="12dp" android:layout_marginTop="8dp"
        android:background="#1C1C1C"
        android:paddingHorizontal="12dp"/>

    <ProgressBar android:id="@+id/pbLoading"
        android:layout_width="wrap_content" android:layout_height="48dp"
        android:layout_gravity="center" android:visibility="gone"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:id="@+id/layoutStats"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp"
            android:paddingBottom="16dp"/>
    </ScrollView>
</LinearLayout>